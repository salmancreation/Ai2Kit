# PHPStan level 6 (PRD §11). WordPress stubs come from szepeviktor/phpstan-wordpress;
# Elementor classes are resolved from the local copy fetched by scripts/fetch-deps.sh.
parameters:
	level: 6
	phpVersion: 70400
	paths:
		- ai2kit.php
		- uninstall.php
		- includes
	scanDirectories:
		- ../../.deps/elementor/core
		- ../../.deps/elementor/includes
		- ../../.deps/elementor/modules
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# build/*.asset.php are generated by the admin app build (not committed); CI's PHP job doesn't build it.
		-
			message: '#^Path in require\(\) "[^"]+/build/[a-z]+\.asset\.php" is not a file or it does not exist\.$#'
			reportUnmatched: false

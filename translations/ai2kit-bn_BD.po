#: build/index.js:51
msgid "My React/Vite site converts to a blank page"
msgstr "আমার React/Vite সাইট কনভার্ট করলে ফাঁকা পেজ আসে"

#: build/index.js:51
msgid "Upload the built output (the dist folder as a ZIP), not the project source. Build with a relative base so asset paths work from any folder."
msgstr "প্রজেক্টের সোর্স নয়, বিল্ড আউটপুট (dist ফোল্ডার ZIP করে) আপলোড করুন। রিলেটিভ base দিয়ে বিল্ড করুন, যাতে যেকোনো ফোল্ডার থেকে অ্যাসেট পাথ কাজ করে।"

#: build/index.js:51
msgid "Images are missing"
msgstr "ছবি দেখা যাচ্ছে না"

#: build/index.js:51
msgid "The build uses absolute paths (/assets/…). Ai2Kit fixes most automatically; building with --base=./ fixes the rest."
msgstr "বিল্ডটি অ্যাবসোলিউট পাথ (/assets/…) ব্যবহার করছে। Ai2Kit বেশিরভাগই স্বয়ংক্রিয়ভাবে ঠিক করে; --base=./ দিয়ে বিল্ড করলে বাকিগুলোও ঠিক হয়।"

#: build/index.js:51
msgid "Imported pages render blank"
msgstr "ইমপোর্ট করা পেজ ফাঁকা দেখায়"

#: build/index.js:51
msgid "Turn on Flexbox Container in Elementor → Settings → Features. The Check step can do it for you."
msgstr "Elementor → Settings → Features-এ Flexbox Container চালু করুন। চেক ধাপেই এটি আপনার জন্য করে দেওয়া যায়।"

#: build/index.js:51
msgid "A section looks different"
msgstr "একটি সেকশন অন্যরকম দেখাচ্ছে"

#: build/index.js:51
msgid "Switch it to HTML in Review to keep it pixel-exact, or keep it Native and adjust it in Elementor."
msgstr "হুবহু রাখতে রিভিউতে এটিকে HTML-এ বদলান, অথবা নেটিভ রেখে Elementor-এ ঠিক করে নিন।"

#: build/index.js:51
msgid "Fonts don't match"
msgstr "ফন্ট মিলছে না"

#: build/index.js:51
msgid "Ai2Kit sets the font family on each widget; Elementor loads Google Fonts automatically. Self-hosted fonts need to be added in Elementor → Custom Fonts."
msgstr "Ai2Kit প্রতিটি উইজেটে ফন্ট ফ্যামিলি সেট করে; Elementor Google Fonts নিজে থেকেই লোড করে। নিজের সার্ভারে রাখা ফন্ট Elementor → Custom Fonts-এ যোগ করতে হয়।"

#: build/index.js:51
msgid "Quick answers to the most common questions."
msgstr "সবচেয়ে সাধারণ প্রশ্নগুলোর দ্রুত উত্তর।"

#: build/index.js:51
msgid "Build a Lovable, Bolt or Vite project for upload"
msgstr "আপলোডের জন্য Lovable, Bolt বা Vite প্রজেক্ট বিল্ড করুন"

#: build/index.js:51
msgid "Troubleshooting"
msgstr "সমস্যা সমাধান"

#: build/index.js:51
msgid "Known limits"
msgstr "জানা সীমাবদ্ধতা"

#: build/index.js:51
msgid "Ai2Kit converts presentational pages. App logic and backends (logins, dashboards, databases), canvas/WebGL, and complex absolutely positioned layouts are kept as HTML or not converted."
msgstr "Ai2Kit উপস্থাপনামূলক পেজ কনভার্ট করে। অ্যাপের লজিক ও ব্যাকএন্ড (লগইন, ড্যাশবোর্ড, ডাটাবেস), canvas/WebGL এবং জটিল অ্যাবসোলিউট পজিশনের লেআউট HTML হিসেবে রাখা হয় অথবা কনভার্ট হয় না।"

#: build/index.js:51
msgid "Convert every route of a site in one job"
msgstr "একবারে সাইটের সব পেজ কনভার্ট করুন"

#: build/index.js:51
msgid "Header and footer templates, and real WordPress menus"
msgstr "হেডার ও ফুটার টেমপ্লেট, এবং আসল WordPress মেনু"

#: build/index.js:51
msgid "Native tabs, carousels, counters and popups"
msgstr "নেটিভ ট্যাব, ক্যারোসেল, কাউন্টার ও পপআপ"

#: build/index.js:51
msgid "Forms with email delivery and spam protection"
msgstr "ইমেইল পাঠানো ও স্প্যাম সুরক্ষাসহ ফর্ম"

#: build/index.js:51
msgid "Repeated cards → custom post types with loop templates"
msgstr "পুনরাবৃত্ত কার্ড → লুপ টেমপ্লেটসহ কাস্টম পোস্ট টাইপ"

#: build/index.js:51
msgid "Entrance animations and Elementor v4 classes & variables"
msgstr "এন্ট্রান্স অ্যানিমেশন এবং Elementor v4 ক্লাস ও ভেরিয়েবল"

#: build/index.js:51
msgid "Kit export, cloud builds and a Chrome companion"
msgstr "কিট এক্সপোর্ট, ক্লাউড বিল্ড এবং Chrome কম্প্যানিয়ন"

#: build/index.js:51
#: build/index.js:52
msgid "Ai2Kit Pro"
msgstr "Ai2Kit Pro"


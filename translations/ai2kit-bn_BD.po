#: includes/Services/ElementorWriter.php:34
msgid "Converted page"
msgstr "কনভার্ট করা পেজ"

#: includes/Services/ElementorWriter.php:47
msgid "Elementor couldn't create the page."
msgstr "Elementor পেজটি তৈরি করতে পারেনি।"

#: includes/Services/ElementorWriter.php:58
msgid "Elementor couldn't save the converted layout."
msgstr "Elementor কনভার্ট করা লেআউট সেভ করতে পারেনি।"

#: includes/Services/Importer.php:29
msgid "Elementor is not active."
msgstr "Elementor চালু নেই।"

#: includes/Services/Importer.php:32
msgid "Flexbox Container is off, so imported pages would render blank."
msgstr "Flexbox Container বন্ধ আছে, তাই ইমপোর্ট করা পেজ ফাঁকা দেখাবে।"

#: includes/Services/Importer.php:36
msgid "Elementor's site settings (kit) are missing and couldn't be recreated."
msgstr "Elementor-এর সাইট সেটিংস (কিট) পাওয়া যায়নি এবং আবার তৈরি করা যায়নি।"

#: includes/Services/Importer.php:60
msgid "Elementor v4 output needs Elementor 4 with the Atomic editor turned on. Choose classic widgets (v3) instead."
msgstr "Elementor v4 আউটপুটের জন্য Atomic এডিটর চালু থাকা Elementor 4 দরকার। এর বদলে ক্লাসিক উইজেট (v3) বেছে নিন।"

#. translators: %d: number of blocks kept as HTML.
#: includes/Services/Importer.php:104
#, php-format
msgid "%d block was kept as HTML — review it in Elementor."
msgid_plural "%d blocks were kept as HTML — review them in Elementor."
msgstr[0] "%d টি ব্লক HTML হিসেবে রাখা হয়েছে — Elementor-এ দেখে নিন।"
msgstr[1] "%d টি ব্লক HTML হিসেবে রাখা হয়েছে — Elementor-এ দেখে নিন।"

#: includes/Services/Importer.php:110
msgid "A form was kept as HTML. Connect it to an email address or a form plugin before going live."
msgstr "একটি ফর্ম HTML হিসেবে রাখা হয়েছে। সাইট লাইভ করার আগে এটিকে একটি ইমেইল ঠিকানা বা ফর্ম প্লাগইনের সাথে যুক্ত করুন।"

#. translators: %d: number of CSS rules.
#: includes/Services/Importer.php:117
#, php-format
msgid "%d style no Elementor control covers (like gradient text) was kept as CSS scoped to this page."
msgid_plural "%d styles no Elementor control covers (like gradient text or rotation) were kept as CSS scoped to this page."
msgstr[0] "Elementor-এর কোনো কন্ট্রোলে নেই এমন %d টি স্টাইল (যেমন গ্রেডিয়েন্ট টেক্সট) শুধু এই পেজের CSS হিসেবে রাখা হয়েছে।"
msgstr[1] "Elementor-এর কোনো কন্ট্রোলে নেই এমন %d টি স্টাইল (যেমন গ্রেডিয়েন্ট টেক্সট বা রোটেশন) শুধু এই পেজের CSS হিসেবে রাখা হয়েছে।"

#. translators: %d: number of icons.
#: includes/Services/Importer.php:124
#, php-format
msgid "%d icon couldn't be imported as SVG and uses the closest Font Awesome icon instead."
msgid_plural "%d icons couldn't be imported as SVG and use the closest Font Awesome icon instead."
msgstr[0] "%d টি আইকন SVG হিসেবে ইমপোর্ট করা যায়নি, তাই সবচেয়ে কাছাকাছি Font Awesome আইকন ব্যবহার করা হয়েছে।"
msgstr[1] "%d টি আইকন SVG হিসেবে ইমপোর্ট করা যায়নি, তাই সবচেয়ে কাছাকাছি Font Awesome আইকন ব্যবহার করা হয়েছে।"

#. translators: %d: number of images.
#: includes/Services/Importer.php:131
#, php-format
msgid "%d image couldn't be imported and still points to its original address."
msgid_plural "%d images couldn't be imported and still point to their original addresses."
msgstr[0] "%d টি ছবি ইমপোর্ট করা যায়নি, এটি এখনো মূল ঠিকানা থেকে লোড হয়।"
msgstr[1] "%d টি ছবি ইমপোর্ট করা যায়নি, এগুলো এখনো মূল ঠিকানা থেকে লোড হয়।"

#: includes/Services/Jobs.php:28
#: includes/Services/Jobs.php:41
msgid "The upload didn't finish."
msgstr "আপলোড শেষ হয়নি।"

